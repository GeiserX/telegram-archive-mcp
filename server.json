{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GeiserX/telegram-archive-mcp",
  "title": "Telegram Archive",
  "description": "Search and read your archived Telegram chats and messages",
  "repository": {
    "url": "https://github.com/GeiserX/telegram-archive-mcp",
    "source": "github",
    "id": "1198347244"
  },
  "websiteUrl": "https://geiserx.github.io/telegram-archive-mcp/",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/GeiserX/telegram-archive-mcp/main/docs/images/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "telegram-archive-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TELEGRAM_ARCHIVE_URL",
          "description": "Telegram Archive instance URL (e.g. http://localhost:8000)",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TELEGRAM_ARCHIVE_USER",
          "description": "Telegram Archive login username",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TELEGRAM_ARCHIVE_PASS",
          "description": "Telegram Archive login password",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "READ_ONLY",
          "description": "Set to true to hide refresh_stats, the one tool that asks the viewer to do work",
          "isRequired": false,
          "format": "boolean",
          "isSecret": false
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "drumsergio/telegram-archive-mcp:v0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TELEGRAM_ARCHIVE_URL",
          "description": "Telegram Archive instance URL (e.g. http://localhost:8000)",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TELEGRAM_ARCHIVE_USER",
          "description": "Telegram Archive login username",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "TELEGRAM_ARCHIVE_PASS",
          "description": "Telegram Archive login password",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "READ_ONLY",
          "description": "Set to true to hide refresh_stats, the one tool that asks the viewer to do work",
          "isRequired": false,
          "format": "boolean",
          "isSecret": false
        }
      ]
    }
  ]
}
